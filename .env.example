# Copy to .env and fill in. .env is uncommitted.

# Langfuse project keys seeded by the stack. The jupyter service receives these
# automatically; export them when running the notebook from the host.
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-hackathon
LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-hackathon
LANGFUSE_BASE_URL=http://localhost:3000

# JupyterLab token for http://localhost:8888
JUPYTER_TOKEN=hackathon

# External OpenAI-compatible inference. No model service runs in compose.
OPENAI_BASE_URL=https://your-provider.example/v1
OPENAI_API_KEY=replace-me
OPENAI_MODEL=replace-me
